{
  "region": "ap-shanghai",
  "namespace": "default",
  "package": "deploy/cos-probe.zip",
  "functions": [
    {"name": "calorie-cos-ingress-probe", "handler": "cos_pipeline_entry.ingress_handler", "environment": [], "function_url": "CAM authenticated HTTPS; anonymous access disabled"},
    {"name": "calorie-cos-msg-probe", "handler": "cos_pipeline_entry.message_handler", "environment_keys": ["DEEPSEEK_API_KEY", "FEISHU_APP_ID", "FEISHU_APP_SECRET", "COS_PROBE_CHAT_ID", "TRACE_ENABLED"]},
    {"name": "calorie-cos-sync-probe", "handler": "cos_pipeline_entry.sync_handler", "environment_keys": ["FEISHU_APP_ID", "FEISHU_APP_SECRET", "BITABLE_APP_TOKEN", "COS_PROBE_TABLE_ID", "TRACE_ENABLED"]}
  ],
  "runtime": "Python3.10",
  "memory_mb": 512,
  "timeout_seconds": 120,
  "maximum_concurrency_each": 1,
  "role": "calorie-cos-probe-role",
  "existing_role_policy": "cos-probe/ objects read/write in the one approved test bucket; no deletion",
  "added_policy": "cos-pipeline-url-policy.json: InvokeFunctionUrl only calorie-cos-ingress-probe",
  "cos_triggers": [
    {"function": "calorie-cos-msg-probe", "event": "cos:ObjectCreated:Put", "prefix": "cos-probe/pipeline/pipeline-validation/inbox/", "suffix": ".json"},
    {"function": "calorie-cos-msg-probe", "event": "cos:ObjectCreated:Put", "prefix": "cos-probe/pipeline/hard-restart/inbox/", "suffix": ".json"},
    {"function": "calorie-cos-sync-probe", "event": "cos:ObjectCreated:Put", "prefix": "cos-probe/pipeline/pipeline-validation/outbox/", "suffix": ".json"},
    {"function": "calorie-cos-msg-probe", "event": "cos:ObjectCreated:Put", "prefix": "cos-probe/pipeline/idle-pipeline-validation/inbox/", "suffix": ".json"},
    {"function": "calorie-cos-sync-probe", "event": "cos:ObjectCreated:Put", "prefix": "cos-probe/pipeline/idle-pipeline-validation/outbox/", "suffix": ".json"}
  ],
  "faults": "one 45-second sync delay; one os._exit(73) immediately after durable write_intake in hard-restart scope only",
  "production_migration": false,
  "cos_budget_yuan": 1,
  "no_resource_packages": true
}
